NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=LangChain Training Plan

# Use "nvidia" or "openrouter".
# The other provider becomes the fallback automatically.
PRIMARY_PROVIDER=nvidia

# Optional backend tuning for long AI generations.
TRAINING_PLAN_MODEL_TIMEOUT_MS=600000
TRAINING_PLAN_JOB_LEASE_MS=1500000
TRAINING_PLAN_WORKER_INTERVAL_MS=5000
TRAINING_PLAN_WORKER_RUN_ONCE=false

# Supabase Auth.
# Use public/publishable keys here. Never expose service_role keys in frontend env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Backend-only key used by the durable training generation worker.
SUPABASE_SECRET_KEY=

# Frontend public auth configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Leave blank to return to the current browser origin in local development.
# Set explicitly in deploys, for example https://funcione.pages.dev.
VITE_AUTH_REDIRECT_URL=

# E2E only. Do not enable in real environments.
# VITE_AUTH_MODE=mock

# Google AdSense public configuration.
# These IDs are exposed in the browser by design. Keep disabled for local dev.
VITE_ADS_ENABLED=false
# Render real AdSense elements by default. Set true only for stable E2E markers.
VITE_ADS_TEST_MODE=false
VITE_ADSENSE_CLIENT_ID=ca-pub-6699167964598590
VITE_ADSENSE_SLOT_TRAINING_PREPARATION=9544709295
VITE_ADSENSE_SLOT_PRE_FOOTER=7261326735
VITE_ADSENSE_SLOT_DESKTOP_SIDEBAR=6487869331
