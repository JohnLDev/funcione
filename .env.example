NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=LangChain Training Plan

# Use "nvidia" or "openrouter".
# The other provider becomes the fallback automatically.
PRIMARY_PROVIDER=nvidia

# Supabase Auth.
# Use public/publishable keys here. Never expose service_role keys in frontend env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Frontend public auth configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# E2E only. Do not enable in real environments.
# VITE_AUTH_MODE=mock
