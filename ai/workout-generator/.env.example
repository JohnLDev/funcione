# Docker Model Runner (OpenAI-compatible endpoint)
# This URL works from inside Docker containers with Docker Model Runner enabled.
# For local development outside Docker, use: http://localhost:12434/engines/llama.cpp/v1
MODEL_RUNNER_BASE_URL=http://model-runner.docker.internal/engines/llama.cpp/v1
MODEL_RUNNER_MODEL=ai/llama3.2:1B-Q4_0
MODEL_RUNNER_TEMPERATURE=0.7
